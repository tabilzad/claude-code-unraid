#!/bin/bash
# claude-unraid: helper CLI for the claude-code-unraid plugin (SPEC section 11).
#
#   claude-unraid status [--json]     plugin, binary, tmux, mode, data dir, auth, policy
#   claude-unraid work <name>         create a workspace and print how to use it
#   claude-unraid token set [--stdin] store the emergency token (read from stdin)
#   claude-unraid token clear         delete it
#   claude-unraid token status        is one present (never prints it)
#   claude-unraid verify              re-hash the installed binary against the pin
#   claude-unraid migrate-login       copy a login made in fallback mode to the data dir
#   claude-unraid doctor              self-checks plus `claude doctor`
#   claude-unraid start <ws> [--remote-control] [--resume ID]   supervised session in tmux
#   claude-unraid stop <ws>|--all [--timeout N] [--mark-restore]
#   claude-unraid attach <ws> | list | restore [--dry-run]
#
# Exit codes: 0 ok, 1 a check failed, 64 usage, 69 tmux unavailable, 77 Remote
# Control disabled, 78 no verified binary.
set -uo pipefail

PLUGIN=claude-code-unraid
PLUGIN_DIR="${ROOT:-}/usr/local/emhttp/plugins/$PLUGIN"
if [ ! -r "$PLUGIN_DIR/scripts/lib.sh" ]; then
  printf 'claude-unraid: %s is not installed (%s is missing)\n' "$PLUGIN" "$PLUGIN_DIR/scripts/lib.sh" >&2
  exit 81
fi
CCU_SCRIPT_NAME=claude-unraid
# shellcheck source=src/usr/local/emhttp/plugins/claude-code-unraid/scripts/lib.sh
. "$PLUGIN_DIR/scripts/lib.sh"
SCRIPTS="$PLUGIN_DIR/scripts"
TOKEN_FILE="$FLASH_DIR/emergency-token"
WORKSPACE_RE='^[a-z0-9][a-z0-9._-]{0,47}$'

usage() {
  sed -n '2,/^set -uo/{/^set -uo/d;s/^# \{0,1\}//;p}' "$0"
}

die() {
  printf 'claude-unraid: %s\n' "$*" >&2
  exit "${2:-1}"
}

plugin_version() {
  local entry
  for entry in "$ROOT/var/lib/pkgtools/packages/$PLUGIN"-* "$ROOT/var/log/packages/$PLUGIN"-*; do
    [ -f "$entry" ] || continue
    entry=$(basename -- "$entry")
    entry=${entry#"$PLUGIN-"}
    printf '%s' "${entry%-noarch-*}"
    return 0
  done
  printf 'unknown'
}

# flash_export: "-" (not exported), "e", "eh" or "unknown"
flash_export() {
  ini_section_get "$DISKS_INI" flash export 2>/dev/null || printf 'unknown'
}

flash_exported() {
  case "$(flash_export)" in
    - | unknown) printf 'no' ;;
    *) printf 'yes' ;;
  esac
}

# binary_verified: yes when the installed binary re-hashes to the pinned sha256
binary_verified() {
  local path sha
  path=$(state_get "$BINARY_STATE" path 2>/dev/null || true)
  sha=$(state_get "$BINARY_STATE" sha256 2>/dev/null || true)
  if [ -n "$path" ] && [ -n "$sha" ] && is_regular_nonlink "$path" && sha256_eq "$path" "$sha"; then
    printf 'yes'
  else
    printf 'no'
  fi
}

# login_present CONFIG_DIR: a persisted claude.ai or API login exists there
login_present() {
  local dir=$1
  if [ -s "$ROOT$dir/.credentials.json" ]; then
    printf 'yes'
    return
  fi
  if [ -s "$ROOT$dir/.claude.json" ] && grep -q '"oauthAccount"' "$ROOT$dir/.claude.json" 2>/dev/null; then
    printf 'yes'
    return
  fi
  printf 'no'
}

# ---------------------------------------------------------------------------
cmd_status() {
  local json=0
  [ "${1:-}" = --json ] && json=1
  local pversion cversion csource cerror cpath cverified tversion terror mode config_dir
  local dd_path dd_valid dd_reason dd_fuse login token_present exported line f
  pversion=$(plugin_version)
  cversion=$(state_get "$BINARY_STATE" version 2>/dev/null || true)
  csource=$(state_get "$BINARY_STATE" source 2>/dev/null || true)
  cerror=$(state_get "$BINARY_STATE" error 2>/dev/null || true)
  cpath=$(state_get "$BINARY_STATE" path 2>/dev/null || true)
  cverified=$(binary_verified)
  tversion=$(state_get "$TMUX_STATE" version 2>/dev/null || true)
  terror=$(state_get "$TMUX_STATE" error 2>/dev/null || true)
  mode=$("$SCRIPTS/mode" get)
  config_dir=$("$SCRIPTS/mode" config-dir)
  dd_path=""
  dd_valid=no
  dd_reason=""
  dd_fuse=no
  while IFS= read -r line; do
    case "$line" in
      DATA_DIR=*) dd_path=${line#DATA_DIR=} ;;
      VALID=*) dd_valid=${line#VALID=} ;;
      REASON=*) dd_reason=${line#REASON=} ;;
      FUSE=*) dd_fuse=${line#FUSE=} ;;
    esac
  done < <("$SCRIPTS/data-dir" --check 2>/dev/null || true)
  login=$(login_present "$config_dir")
  token_present=no
  is_regular_nonlink "$TOKEN_FILE" && token_present=yes
  exported=$(flash_exported)

  if [ "$json" = 1 ]; then
    {
      printf 'plugin_version=%s\n' "$pversion"
      printf 'claude.version=%s\n' "$cversion"
      printf 'claude.source=%s\n' "$csource"
      printf 'claude.path=%s\n' "$cpath"
      printf 'claude.verified=@bool:%s\n' "$cverified"
      printf 'claude.error=%s\n' "$cerror"
      printf 'tmux.version=%s\n' "$tversion"
      printf 'tmux.available=@bool:%s\n' "$([ -n "$tversion" ] && echo yes || echo no)"
      printf 'tmux.error=%s\n' "$terror"
      printf 'mode=%s\n' "$mode"
      printf 'config_dir=%s\n' "$config_dir"
      printf 'data_dir.path=%s\n' "$dd_path"
      printf 'data_dir.valid=@bool:%s\n' "$dd_valid"
      printf 'data_dir.fuse=@bool:%s\n' "$dd_fuse"
      printf 'data_dir.reason=%s\n' "$dd_reason"
      printf 'auth.login=@bool:%s\n' "$login"
      printf 'auth.emergency_token=@bool:%s\n' "$token_present"
      printf 'flash_exported=@bool:%s\n' "$exported"
      for f in "$POLICY_DIR"/*.json; do
        [ -f "$f" ] && printf 'policy_files[]=%s\n' "$(basename -- "$f")"
      done
      local sws sstate sid sstarted
      while IFS=$'	' read -r sws sstate sid sstarted; do
        [ -n "$sws" ] || continue
        printf 'sessions[]=%s
' "$sws|$sstate|$sid|$sstarted"
      done < <(sessions_tsv)
    } | "$SCRIPTS/kv2json"
    return 0
  fi

  printf 'plugin:        %s %s\n' "$PLUGIN" "$pversion"
  if [ -n "$cversion" ]; then
    printf 'claude code:   %s (from %s, verified: %s)\n' "$cversion" "$csource" "$cverified"
    [ -n "$cerror" ] && printf '               degraded: %s\n' "$cerror"
  else
    printf 'claude code:   NOT AVAILABLE%s\n' "${cerror:+ ($cerror)}"
  fi
  if [ -n "$tversion" ]; then
    printf 'tmux:          %s\n' "$tversion"
  else
    printf 'tmux:          NOT AVAILABLE%s (supervised sessions disabled)\n' "${terror:+ ($terror)}"
  fi
  printf 'mode:          %s\n' "$mode"
  printf 'config dir:    %s\n' "$config_dir"
  if [ "$dd_valid" = yes ]; then
    printf 'data dir:      %s%s\n' "$dd_path" "$([ "$dd_fuse" = yes ] && echo ' (on /mnt/user, FUSE)')"
  else
    printf 'data dir:      %s (NOT USABLE: %s)\n' "$dd_path" "$dd_reason"
  fi
  printf 'login:         %s\n' "$login"
  printf 'emergency tok: %s\n' "$token_present"
  printf 'flash export:  %s\n' "$exported"
  printf 'policy files:  '
  local any=0
  for f in "$POLICY_DIR"/*.json; do
    [ -f "$f" ] || continue
    printf '%s ' "$(basename -- "$f")"
    any=1
  done
  [ "$any" = 1 ] || printf 'none'
  printf '\n'
  printf 'sessions:      '
  local sws sstate sid sstarted sn=0
  while IFS=$'	' read -r sws sstate sid sstarted; do
    [ -n "$sws" ] || continue
    printf '%s (%s) ' "$sws" "$sstate"
    sn=$((sn + 1))
  done < <(sessions_tsv)
  [ "$sn" -gt 0 ] || printf 'none'
  printf '
'
}

# ---------------------------------------------------------------------------
cmd_work() {
  local name=${1:-}
  [[ "$name" =~ $WORKSPACE_RE ]] || die "workspace names are 1-48 characters: lowercase letters, digits, '.', '_' or '-', starting with a letter or digit" 64
  local mode work_dir path
  mode=$("$SCRIPTS/mode" get)
  "$SCRIPTS/mode" ensure-dirs >/dev/null 2>&1 || true
  work_dir=$("$SCRIPTS/mode" work-dir)
  path="$work_dir/$name"
  { mkdir -p -- "$ROOT$path" && chmod 0755 -- "$ROOT$path"; } || die "could not create $path"
  if [ "$mode" = fallback ]; then
    printf 'claude-unraid: note: fallback mode (array not started); this workspace lives in RAM until the array starts.\n' >&2
  fi
  printf '%s\n' "$path"
  printf 'claude-unraid: workspace ready. Start a session with:\n  cd %s && claude\n' "$path" >&2
}

# ---------------------------------------------------------------------------
warn_flash_export() {
  if [ "$(flash_exported)" = yes ]; then
    printf 'claude-unraid: WARNING: the flash share is exported over SMB (Main, Boot Device, Flash, SMB Security Settings). Anyone who can read it can read the emergency token. Set Export to No.\n' >&2
    return 1
  fi
  return 0
}

cmd_token() {
  local sub=${1:-}
  shift || true
  case "$sub" in
    set)
      local from_tty=0 token
      if [ -t 0 ]; then
        [ "${1:-}" = --stdin ] || die "token set reads the token from standard input. Pipe it in (for example from a password manager) or pass --stdin to type it without echo." 64
        from_tty=1
      fi
      if [ "$from_tty" = 1 ]; then
        IFS= read -rs -p 'Emergency token (input hidden): ' token
        printf '\n' >&2
      else
        IFS= read -r token || true
      fi
      token=${token%$'\r'}
      [ -n "$token" ] || die "no token read" 64
      [[ "$token" =~ ^[A-Za-z0-9._~-]{20,4096}$ ]] || die "that does not look like a token (letters, digits, '.', '_', '~', '-', at least 20 characters, no spaces)" 64
      mkdir -p -- "$FLASH_DIR"
      printf '%s\n' "$token" | atomic_write "$TOKEN_FILE" 0600 || die "could not write $TOKEN_FILE"
      unset token
      log notice "emergency token stored"
      printf 'claude-unraid: emergency token stored in %s (used only while the array is not started).\n' "${TOKEN_FILE#"$ROOT"}"
      warn_flash_export || true
      ;;
    clear)
      if [ -e "$TOKEN_FILE" ]; then
        rm -f -- "$TOKEN_FILE"
        log notice "emergency token removed"
        printf 'claude-unraid: emergency token removed.\n'
      else
        printf 'claude-unraid: no emergency token was stored.\n'
      fi
      ;;
    status)
      if is_regular_nonlink "$TOKEN_FILE"; then
        printf 'emergency token: present (%s)\n' "${TOKEN_FILE#"$ROOT"}"
        warn_flash_export || true
      else
        printf 'emergency token: absent\n'
      fi
      ;;
    *) die "token needs set, clear or status" 64 ;;
  esac
}

# ---------------------------------------------------------------------------
cmd_verify() {
  local path sha version
  path=$(state_get "$BINARY_STATE" path 2>/dev/null || true)
  sha=$(state_get "$BINARY_STATE" sha256 2>/dev/null || true)
  version=$(state_get "$BINARY_STATE" version 2>/dev/null || true)
  if [ -z "$path" ] || [ -z "$sha" ]; then
    printf 'verify: no Claude Code binary is installed (%s)\n' "$(state_get "$BINARY_STATE" error 2>/dev/null || echo 'no state')" >&2
    return 78
  fi
  if ! is_regular_nonlink "$path"; then
    printf 'verify: FAIL: %s is missing or not a regular file\n' "$path" >&2
    return 1
  fi
  if sha256_eq "$path" "$sha"; then
    printf 'verify: OK: Claude Code %s at %s matches the pinned sha256\n' "$version" "$path"
    return 0
  fi
  printf 'verify: FAIL: %s does not match the pinned sha256 %s\n' "$path" "$sha" >&2
  log err "verify: $path does not match the pinned sha256"
  notify alert "Claude Code binary verification failed" "$path does not match its pinned sha256. Reinstall the plugin."
  return 1
}

# ---------------------------------------------------------------------------
# A login made while the array was stopped lives in the RAM config. Copy just
# the credentials file into the persistent config dir, never the whole
# directory and never over an existing login (unless --force).
cmd_migrate_login() {
  local force=0 src dest_dir dest
  [ "${1:-}" = --force ] && force=1
  src="$RUN_DIR/fallback-config/.credentials.json"
  [ -s "$src" ] || die "no login found in the fallback configuration ($(printf '%s' "${src#"$ROOT"}"))"
  [ "$("$SCRIPTS/mode" get)" = pool ] || die "the array is not started (fallback mode); try again once it is"
  dest_dir=$("$SCRIPTS/mode" config-dir)
  dest="$ROOT$dest_dir/.credentials.json"
  if [ -s "$dest" ] && [ "$force" = 0 ]; then
    die "$dest_dir already holds a login; pass --force to replace it"
  fi
  mkdir -p -- "$ROOT$dest_dir"
  chmod 0700 -- "$ROOT$dest_dir" 2>/dev/null || true
  atomic_write "$dest" 0600 <"$src" || die "could not write $dest_dir/.credentials.json"
  log notice "login migrated from fallback mode to $dest_dir"
  printf 'claude-unraid: login copied to %s. The fallback copy stays in RAM until the next reboot.
' "$dest_dir"
}

# ---------------------------------------------------------------------------
cmd_doctor() {
  local fails=0 warns=0
  pass() { printf 'PASS  %s\n' "$*"; }
  warn() {
    printf 'WARN  %s\n' "$*"
    warns=$((warns + 1))
  }
  fail() {
    printf 'FAIL  %s\n' "$*"
    fails=$((fails + 1))
  }

  local path sha version err
  path=$(state_get "$BINARY_STATE" path 2>/dev/null || true)
  sha=$(state_get "$BINARY_STATE" sha256 2>/dev/null || true)
  version=$(state_get "$BINARY_STATE" version 2>/dev/null || true)
  err=$(state_get "$BINARY_STATE" error 2>/dev/null || true)
  if [ -n "$path" ] && is_regular_nonlink "$path" && sha256_eq "$path" "$sha"; then
    pass "Claude Code $version installed and verified ($path)"
    [ -n "$err" ] && warn "running a previous version: $err"
  else
    fail "Claude Code binary unavailable: ${err:-not installed}"
  fi

  local tver terr
  tver=$(state_get "$TMUX_STATE" version 2>/dev/null || true)
  terr=$(state_get "$TMUX_STATE" error 2>/dev/null || true)
  if [ -n "$tver" ] && [ -x "$LIB_DIR/bin/tmux" ]; then
    pass "tmux $tver available for supervised sessions"
  else
    warn "tmux unavailable (${terr:-not installed}); supervised sessions and restore are disabled"
  fi

  local mode config_dir
  mode=$("$SCRIPTS/mode" get)
  config_dir=$("$SCRIPTS/mode" config-dir)
  pass "storage mode: $mode (config dir $config_dir)"

  local line dd_path dd_valid dd_reason dd_fuse
  dd_path="" dd_valid=no dd_reason="" dd_fuse=no
  while IFS= read -r line; do
    case "$line" in
      DATA_DIR=*) dd_path=${line#DATA_DIR=} ;;
      VALID=*) dd_valid=${line#VALID=} ;;
      REASON=*) dd_reason=${line#REASON=} ;;
      FUSE=*) dd_fuse=${line#FUSE=} ;;
    esac
  done < <("$SCRIPTS/data-dir" --check 2>/dev/null || true)
  if [ "$dd_valid" = yes ]; then
    if [ "$dd_fuse" = yes ]; then
      warn "data directory $dd_path is on /mnt/user (FUSE); a direct pool path (for example /mnt/cache/appdata/$PLUGIN) is faster and avoids the mover"
    else
      pass "data directory $dd_path"
    fi
  else
    if [ "$(array_state)" = STARTED ]; then
      fail "data directory $dd_path not usable: $dd_reason"
    else
      warn "data directory $dd_path not usable while the array is stopped: $dd_reason"
    fi
  fi

  local free
  free=$(free_kb "$FLASH_DIR" 2>/dev/null || true)
  if [[ "$free" =~ ^[0-9]+$ ]]; then
    if [ "$free" -lt 716800 ]; then
      warn "only $((free / 1024)) MiB free on the flash drive; two cached Claude Code versions need about 560 MiB"
    else
      pass "$((free / 1024)) MiB free on the flash drive"
    fi
  fi

  case "$(flash_export)" in
    -) pass "flash share is not exported over SMB" ;;
    unknown) warn "could not determine whether the flash share is exported (disks.ini unreadable)" ;;
    *)
      if is_regular_nonlink "$TOKEN_FILE"; then
        fail "the flash share is exported over SMB and an emergency token is stored on it; set Export to No or clear the token"
      else
        warn "the flash share is exported over SMB; the plugin's cfg and policy drop-ins are readable by anyone who can reach the share"
      fi
      ;;
  esac
  if is_regular_nonlink "$TOKEN_FILE"; then
    pass "emergency token present (used only in fallback mode)"
  fi

  if [ -f "$POLICY_DIR/99-$PLUGIN-baseline.json" ]; then
    pass "managed policy baseline present"
  else
    fail "managed policy baseline missing from $POLICY_DIR (run the plugin install again)"
  fi

  if [ -x "$BIN_LAUNCHER" ] && [ -n "$path" ] && is_regular_nonlink "$path"; then
    printf -- '----- claude doctor -----\n'
    if run_with_timeout 90 "$BIN_LAUNCHER" doctor </dev/null; then
      pass "claude doctor completed"
    else
      warn "claude doctor exited with status $?"
    fi
  fi

  printf 'doctor: %s failure(s), %s warning(s)\n' "$fails" "$warns"
  [ "$fails" = 0 ]
}

# ---------------------------------------------------------------------------
# Supervised sessions: the bundled tmux, one session per workspace
# ---------------------------------------------------------------------------
TMUX_BIN="$LIB_DIR/bin/tmux"
TMUX_SOCK="$RUN_DIR/tmux.sock"
SESSIONS_DIR="$RUN_DIR/sessions"
REGISTRY="$SCRIPTS/registry"

tmux_ok() { [ -x "$TMUX_BIN" ]; }
tmx() { "$TMUX_BIN" -S "$TMUX_SOCK" "$@"; }
session_name() { printf '%s-%s' "$PLUGIN" "$1"; }
session_running() { tmx has-session -t "=$(session_name "$1")" 2>/dev/null; }

need_tmux() {
  tmux_ok && return 0
  die "supervised sessions need the bundled tmux, which is not available ($(state_get "$TMUX_STATE" error 2>/dev/null || echo 'not fetched yet')). Run 'claude-unraid doctor'; a reboot or a plugin reinstall retries the download." 69
}

# registry_file: the registry next to the active config dir (host path + ROOT)
registry_file() {
  local cd
  cd=$("$SCRIPTS/mode" config-dir)
  printf '%s/sessions.json' "$ROOT$(dirname -- "$cd")"
}

# forget_session WS: drop the pid and info files of a session
forget_session() {
  rm -f -- "${SESSIONS_DIR:?}/${1:?}.pid" "${SESSIONS_DIR:?}/${1:?}.info"
}

record_session_pid() { # WS
  local pid
  pid=$(tmx list-panes -t "=$(session_name "$1")" -F '#{pane_pid}' 2>/dev/null | head -n1)
  mkdir -p -- "$SESSIONS_DIR"
  if [[ "$pid" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$pid" >"$SESSIONS_DIR/$1.pid"
  fi
}

running_workspaces() {
  tmx list-sessions -F '#{session_name}' 2>/dev/null | sed -n "s/^$PLUGIN-//p"
}

# launch_session WS RESUME_ID REMOTE(0|1): start the tmux session running the
# launcher in the workspace. Environment flags travel through env(1) so that
# the pane PID stays the Claude Code process (every hop execs).
launch_session() {
  local ws=$1 resume_id=$2 remote=$3 work_dir dir
  "$SCRIPTS/mode" ensure-dirs >/dev/null 2>&1 || true
  work_dir=$("$SCRIPTS/mode" work-dir)
  dir="$ROOT$work_dir/$ws"
  { mkdir -p -- "$dir" && chmod 0755 -- "$dir"; } || die "could not create $work_dir/$ws"
  local -a cmd=(env CLAUDE_CODE_UNRAID_SUPERVISED=1)
  [ "$remote" = 1 ] && cmd+=(CLAUDE_CODE_UNRAID_REMOTE_CONTROL=1)
  cmd+=("$BIN_LAUNCHER")
  [ -n "$resume_id" ] && cmd+=(--resume "$resume_id")
  [ "$remote" = 1 ] && cmd+=(--remote-control "$ws")
  mkdir -p -- "$RUN_DIR" "$SESSIONS_DIR"
  tmx new-session -d -s "$(session_name "$ws")" -c "$dir" -- "${cmd[@]}" || return 1
  record_session_pid "$ws"
  printf 'workspace=%s\ncwd=%s\nstarted_at=%s\nremote_control=%s\nresume=%s\n' \
    "$ws" "$work_dir/$ws" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$remote" "$resume_id" >"$SESSIONS_DIR/$ws.info"
  log info "supervised session started: $ws${resume_id:+ (resume $resume_id)}$([ "$remote" = 1 ] && echo ' with Remote Control')"
  return 0
}

cmd_start() {
  local ws="" remote=0 resume_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --remote-control) remote=1 ;;
      --resume)
        resume_id=${2:-}
        shift
        ;;
      -*) die "unknown option $1" 64 ;;
      *) ws=$1 ;;
    esac
    shift
  done
  [[ "$ws" =~ $WORKSPACE_RE ]] || die "workspace names are 1-48 characters: lowercase letters, digits, '.', '_' or '-', starting with a letter or digit" 64
  [ -z "$resume_id" ] || [[ "$resume_id" =~ ^[A-Za-z0-9_-]{1,128}$ ]] || die "that does not look like a session id" 64
  need_tmux
  if [ "$remote" = 1 ] && [ "$(cfg_bool REMOTE_CONTROL no)" != yes ]; then
    die "Remote Control is disabled in the plugin settings (REMOTE_CONTROL). Enable it there first; sessions then store their transcript on Anthropic's servers while connected." 77
  fi
  if session_running "$ws"; then
    printf 'claude-unraid: session %s is already running. Attach with: claude-unraid attach %s\n' "$ws" "$ws"
    return 0
  fi
  launch_session "$ws" "$resume_id" "$remote" || die "could not start the tmux session for $ws" 1
  local work_dir
  work_dir=$("$SCRIPTS/mode" work-dir)
  printf 'claude-unraid: session %s started in %s/%s. Attach with: claude-unraid attach %s\n' "$ws" "$work_dir" "$ws" "$ws"
  if [ "$("$SCRIPTS/mode" get)" = fallback ]; then
    printf 'claude-unraid: note: fallback mode (array not started); this session lives in RAM and is stopped when the mode changes.\n' >&2
  fi
}

# stop_sessions TIMEOUT MARK_RESTORE WS...: /exit, then SIGTERM, then SIGKILL,
# all within TIMEOUT seconds.
stop_sessions() {
  local timeout=$1 mark=$2
  shift 2
  local -a targets=("$@") ids=()
  local ws reg id deadline alive pid
  reg=$(registry_file)
  for ws in "${targets[@]}"; do
    id=$("$REGISTRY" live "$reg" "$ws" 2>/dev/null || true)
    [ -n "$id" ] && ids+=("$id")
  done
  if [ "$mark" = 1 ] && [ "${#ids[@]}" -gt 0 ]; then
    "$REGISTRY" mark-restore "$reg" 1 "${ids[@]}" 2>/dev/null || log warning "could not flag sessions for restore"
  fi
  for ws in "${targets[@]}"; do
    tmx send-keys -t "=$(session_name "$ws"):" -l '/exit' 2>/dev/null || true
    tmx send-keys -t "=$(session_name "$ws"):" Enter 2>/dev/null || true
  done
  deadline=$((SECONDS + timeout))
  local soft=$((SECONDS + (timeout + 1) / 2))
  while [ "$SECONDS" -lt "$soft" ]; do
    alive=0
    for ws in "${targets[@]}"; do session_running "$ws" && alive=1; done
    [ "$alive" = 0 ] && break
    sleep 0.25
  done
  for ws in "${targets[@]}"; do
    if session_running "$ws"; then
      pid=$(cat "$SESSIONS_DIR/$ws.pid" 2>/dev/null || true)
      [[ "$pid" =~ ^[0-9]+$ ]] && kill -TERM "$pid" 2>/dev/null
    fi
  done
  while [ "$SECONDS" -lt "$deadline" ]; do
    alive=0
    for ws in "${targets[@]}"; do session_running "$ws" && alive=1; done
    [ "$alive" = 0 ] && break
    sleep 0.25
  done
  local killed=0
  for ws in "${targets[@]}"; do
    if session_running "$ws"; then
      pid=$(cat "$SESSIONS_DIR/$ws.pid" 2>/dev/null || true)
      [[ "$pid" =~ ^[0-9]+$ ]] && kill -KILL "$pid" 2>/dev/null
      tmx kill-session -t "=$(session_name "$ws")" 2>/dev/null || true
      killed=$((killed + 1))
      log warning "session $ws did not exit within ${timeout}s; killed"
    fi
    forget_session "$ws"
  done
  if [ "$mark" = 0 ] && [ "${#ids[@]}" -gt 0 ]; then
    "$REGISTRY" mark-ended "$reg" stopped "${ids[@]}" 2>/dev/null || true
  fi
  log info "stopped ${#targets[@]} supervised session(s): ${targets[*]} ($killed killed)"
  printf 'claude-unraid: stopped %s session(s): %s\n' "${#targets[@]}" "${targets[*]}"
}

cmd_stop() {
  local all=0 timeout=10 mark=0 names=() ws
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=1 ;;
      --timeout)
        timeout=${2:-}
        shift
        ;;
      --mark-restore) mark=1 ;;
      -*) die "unknown option $1" 64 ;;
      *) names+=("$1") ;;
    esac
    shift
  done
  [[ "$timeout" =~ ^[0-9]+$ ]] && [ "$timeout" -ge 1 ] || die "--timeout needs a number of seconds" 64
  if ! tmux_ok; then
    local f
    for f in "$SESSIONS_DIR"/*.pid "$SESSIONS_DIR"/*.info; do
      [ -e "$f" ] && rm -f -- "$f"
    done
    printf 'claude-unraid: tmux is not available, so no supervised session can be running.\n'
    return 0
  fi
  local -a targets=()
  if [ "$all" = 1 ]; then
    while IFS= read -r ws; do [ -n "$ws" ] && targets+=("$ws"); done < <(running_workspaces)
  else
    [ "${#names[@]}" -gt 0 ] || die "stop needs a workspace name or --all" 64
    for ws in "${names[@]}"; do
      [[ "$ws" =~ $WORKSPACE_RE ]] || die "bad workspace name: $ws" 64
      if session_running "$ws"; then targets+=("$ws"); else printf 'claude-unraid: %s is not running\n' "$ws"; fi
    done
  fi
  if [ "${#targets[@]}" -eq 0 ]; then
    printf 'claude-unraid: no supervised sessions running.\n'
    return 0
  fi
  stop_sessions "$timeout" "$mark" "${targets[@]}"
}

cmd_attach() {
  local ws=${1:-}
  [[ "$ws" =~ $WORKSPACE_RE ]] || die "attach needs a workspace name" 64
  need_tmux
  session_running "$ws" || die "session $ws is not running (claude-unraid list shows what is; start it with: claude-unraid start $ws)" 1
  exec "$TMUX_BIN" -S "$TMUX_SOCK" attach-session -t "=$(session_name "$ws")"
}

# sessions_tsv: workspace<TAB>state<TAB>session_id<TAB>started_at for every
# known supervised session (running, or with leftover state from a crash)
sessions_tsv() {
  local reg ws id started seen=" " f
  reg=$(registry_file)
  if tmux_ok; then
    while IFS= read -r ws; do
      [ -n "$ws" ] || continue
      seen="$seen$ws "
      id=$("$REGISTRY" live "$reg" "$ws" 2>/dev/null || true)
      started=$(sed -n 's/^started_at=//p' "$SESSIONS_DIR/$ws.info" 2>/dev/null || true)
      printf '%s\trunning\t%s\t%s\n' "$ws" "${id:--}" "${started:--}"
    done < <(running_workspaces)
  fi
  for f in "$SESSIONS_DIR"/*.info; do
    [ -f "$f" ] || continue
    ws=$(basename -- "$f" .info)
    case "$seen" in *" $ws "*) continue ;; esac
    started=$(sed -n 's/^started_at=//p' "$f")
    printf '%s\texited\t-\t%s\n' "$ws" "${started:--}"
  done
}

cmd_list() {
  local ws state id started n=0
  printf '%-20s %-8s %-12s %s\n' WORKSPACE STATE SESSION STARTED
  while IFS=$'\t' read -r ws state id started; do
    [ -n "$ws" ] || continue
    n=$((n + 1))
    printf '%-20s %-8s %-12s %s\n' "$ws" "$state" "${id:0:12}" "$started"
  done < <(sessions_tsv)
  [ "$n" -gt 0 ] || printf '(no supervised sessions; start one with: claude-unraid start <workspace>)\n'
}

cmd_restore() {
  local dry=0
  [ "${1:-}" = --dry-run ] && dry=1
  if [ "$(cfg_bool RESTORE_SESSIONS yes)" != yes ]; then
    printf 'claude-unraid: session restore is disabled in the settings (RESTORE_SESSIONS).\n'
    return 0
  fi
  if [ "$("$SCRIPTS/mode" get)" != pool ]; then
    printf 'claude-unraid: restore only runs in pool mode (the array is not started).\n'
    return 0
  fi
  if ! tmux_ok; then
    log warning "restore skipped: tmux is not available"
    notify warning "Claude Code sessions not restored" "The bundled tmux is not available, so supervised sessions cannot be brought back. Run 'claude-unraid doctor'."
    return 0
  fi
  local reg max cands grace
  reg=$(registry_file)
  max=$(cfg_get MAX_RESTORE 4)
  [[ "$max" =~ ^[0-9]+$ ]] || max=4
  cands=$("$REGISTRY" candidates "$reg" "$max" 2>/dev/null || true)
  if [ -z "$cands" ]; then
    if [ "$dry" = 1 ]; then
      printf '(nothing to restore)\n'
    else
      log info "restore: nothing to bring back"
    fi
    return 0
  fi
  if [ "$dry" = 1 ]; then
    printf '%s\n' "$cands"
    return 0
  fi
  grace=6
  if [ "$test_mode" = 1 ] && [ -n "${CCU_RESTORE_GRACE:-}" ]; then
    grace=$CCU_RESTORE_GRACE
  fi
  local id ws remote restored=0 fresh=0 failed=0 ids=() i use_remote
  while IFS=$'\t' read -r id ws _ _ remote; do
    [ -n "$id" ] || continue
    ids+=("$id")
    if session_running "$ws"; then
      log info "restore: $ws is already running"
      continue
    fi
    use_remote=0
    if [ "$remote" = yes ] && [ "$(cfg_bool REMOTE_CONTROL no)" = yes ]; then
      use_remote=1
    fi
    if ! launch_session "$ws" "$id" "$use_remote"; then
      log warning "restore: could not start $ws"
      failed=$((failed + 1))
      continue
    fi
    for ((i = 0; i < grace * 4; i++)); do
      session_running "$ws" || break
      sleep 0.25
    done
    if session_running "$ws"; then
      restored=$((restored + 1))
      log info "restore: $ws resumed session $id"
    else
      log warning "restore: resuming $id in $ws failed; starting a fresh session there"
      forget_session "$ws"
      if launch_session "$ws" "" "$use_remote"; then
        fresh=$((fresh + 1))
      else
        failed=$((failed + 1))
      fi
    fi
  done <<<"$cands"
  [ "${#ids[@]}" -gt 0 ] && "$REGISTRY" mark-restore "$reg" 0 "${ids[@]}" 2>/dev/null
  local summary="restore: $restored resumed, $fresh started fresh, $failed failed"
  log info "$summary"
  if [ "$failed" -gt 0 ]; then
    notify warning "Claude Code sessions restored with problems" "$summary. See /var/log/$PLUGIN/restore.log."
  elif [ $((restored + fresh)) -gt 0 ]; then
    notify normal "Claude Code sessions restored" "$summary. Attach with: claude-unraid attach <workspace>"
  fi
  printf 'claude-unraid: %s\n' "$summary"
}

# ---------------------------------------------------------------------------
case "${1:-}" in
  status)
    shift
    cmd_status "$@"
    ;;
  work)
    shift
    cmd_work "$@"
    ;;
  token)
    shift
    cmd_token "$@"
    ;;
  verify) cmd_verify ;;
  migrate-login)
    shift
    cmd_migrate_login "$@"
    ;;
  doctor) cmd_doctor ;;
  start)
    shift
    cmd_start "$@"
    ;;
  stop)
    shift
    cmd_stop "$@"
    ;;
  attach)
    shift
    cmd_attach "$@"
    ;;
  list) cmd_list ;;
  restore)
    shift
    cmd_restore "$@"
    ;;
  -h | --help | help | '')
    usage
    [ -n "${1:-}" ] || exit 64
    ;;
  *) die "unknown command '$1' (try: claude-unraid help)" 64 ;;
esac
