<?PHP
/* Claude Code for Unraid: settings page (SPEC section 12).
 *
 * Copyright (c) 2026 tabilzad. MIT License (https://github.com/tabilzad/claude-code-unraid).
 * Not affiliated with Anthropic PBC or Lime Technology, Inc.
 *
 * Everything shown comes from `claude-unraid status --json`. Settings are saved
 * through Unraid's /update.php (CSRF enforced globally), validated server-side
 * by include/update.cfg.php, and the policy is re-rendered by install-policy
 * right after the save. Buttons post to include/exec.php (action allowlist).
 * The Permissions box edits the policy.d/webgui.json drop-in through the
 * policy-save action; include/policy.php validates the JSON before any write.
 * No token, account e-mail or transcript content ever reaches this page.
 *
 * Layout: the custom sections are plain HTML blocks styled by
 * styles/claude-code-unraid.css (scoped to .ccu, themed through data-theme);
 * the settings form keeps Unraid's markdown definition-list layout because
 * /update.php and the inline help toggles depend on it.
 */
$docroot ??= ($_SERVER['DOCUMENT_ROOT'] ?: '/usr/local/emhttp');
require_once "$docroot/plugins/claude-code-unraid/include/status.php";
require_once "$docroot/plugins/claude-code-unraid/include/policy.php";
require_once "$docroot/plugins/claude-code-unraid/include/ui.php";

$ccu_status = ccu_status();
$ccu_cfg = ccu_cfg();
$ccu_claude = $ccu_status['claude'] ?? [];
$ccu_tmux = $ccu_status['tmux'] ?? [];
$ccu_dd = $ccu_status['data_dir'] ?? [];
$ccu_auth = $ccu_status['auth'] ?? [];
$ccu_sessions = is_array($ccu_status['sessions'] ?? null) ? $ccu_status['sessions'] : [];
$ccu_workspaces = is_array($ccu_status['workspaces'] ?? null) ? $ccu_status['workspaces'] : [];
$ccu_policy = is_array($ccu_status['policy_files'] ?? null) ? $ccu_status['policy_files'] : [];
$ccu_remote_on = strtolower((string) ($ccu_cfg['REMOTE_CONTROL'] ?? 'no')) === 'yes';
$ccu_theme = ccu_theme($display['theme'] ?? '');
$ccu_css = '/plugins/claude-code-unraid/styles/claude-code-unraid.css?v='
  . ccu_asset_version("$docroot/plugins/claude-code-unraid/styles/claude-code-unraid.css");

$ccu_warnings = [];
if (($ccu_status['flash_exported'] ?? false) === true) {
  $ccu_warnings[] = ['warn', 'The flash share is exported over SMB. The plugin settings and policy drop-ins are readable by anyone who can reach it'
    . (($ccu_auth['emergency_token'] ?? false) === true ? ', and so is the emergency token. Set Main, Boot Device, Flash, SMB Security Settings, Export to No, or clear the token.' : '.')];
}
if (($ccu_dd['fuse'] ?? false) === true) {
  $ccu_warnings[] = ['warn', 'The data directory is on /mnt/user (FUSE). A direct pool path such as /mnt/cache/appdata/claude-code-unraid is faster and keeps the mover away from Claude\'s transcripts.'];
}
if (($ccu_auth['emergency_token'] ?? false) === true) {
  $ccu_warnings[] = ['warn', 'An emergency token is stored on the flash drive. It is used only while the array is stopped and grants access to your Claude account; keep the flash share unexported.'];
}
if ($ccu_remote_on) {
  $ccu_warnings[] = ['warn', 'Remote Control is allowed. Supervised sessions started with it can be driven from claude.ai or the Claude app, and their transcripts are stored on Anthropic\'s servers while connected.'];
}
if ($ccu_status === []) {
  $ccu_warnings[] = ['bad', 'The plugin helper did not answer (claude-unraid status --json). Reinstall the plugin or check /var/log/claude-code-unraid/install.log.'];
}

/* Summary cards: value, one-line detail and a tone for the state dot. */
$ccu_claude_ver = (string) ($ccu_claude['version'] ?? '');
$ccu_claude_err = (string) ($ccu_claude['error'] ?? '');
$ccu_claude_ok = ($ccu_claude['verified'] ?? false) === true;
$ccu_claude_tone = $ccu_claude_ver === '' ? 'bad' : (($ccu_claude_ok && $ccu_claude_err === '') ? 'ok' : 'warn');
$ccu_mode = (string) ($ccu_status['mode'] ?? 'unknown');
$ccu_mode_tone = $ccu_mode === 'pool' ? 'ok' : ($ccu_mode === 'fallback' ? 'warn' : 'neutral');
$ccu_login = ($ccu_auth['login'] ?? false) === true;
$ccu_tmux_ok = ($ccu_tmux['available'] ?? false) === true;
$ccu_running = 0;
foreach ($ccu_sessions as $ccu_s) {
  if ((explode('|', (string) $ccu_s, 3)[1] ?? '') === 'running') {
    $ccu_running++;
  }
}
$ccu_dd_ok = ($ccu_dd['valid'] ?? false) === true;
$ccu_dd_bytes = $ccu_dd['bytes'] ?? null;
$ccu_dd_tr = $ccu_dd['transcripts_bytes'] ?? null;
$ccu_policy_raw = ccu_policy_read();
$ccu_rule_count = ccu_policy_rule_count($ccu_policy_raw);

function ccu_select(string $name, string $current): string {
  $out = '<select name="' . ccu_h($name) . '">';
  foreach (['no' => 'No', 'yes' => 'Yes'] as $v => $label) {
    $out .= '<option value="' . $v . '"' . ($current === $v ? ' selected' : '') . '>' . $label . '</option>';
  }
  return $out . '</select>';
}
?>

<div class="ccu ccu-hero" data-theme="<?=ccu_h($ccu_theme)?>">
<link rel="stylesheet" href="<?=ccu_h($ccu_css)?>">
