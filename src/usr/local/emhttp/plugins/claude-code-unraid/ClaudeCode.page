</div>
<?endif;?>

<div class="ccu ccu-cards" data-theme="<?=ccu_h($ccu_theme)?>">
<div class="ccu-card" data-tone="<?=ccu_h($ccu_claude_tone)?>">
<div class="ccu-card-label">_(Claude Code)_</div>
<div class="ccu-card-value"><?=ccu_h($ccu_claude_ver !== '' ? $ccu_claude_ver : 'not available')?></div>
<div class="ccu-card-sub"><?if ($ccu_claude_ver !== ''):?><?=ccu_badge($ccu_claude_ok ? 'verified' : 'unverified', $ccu_claude_ok ? 'ok' : 'warn')?><span><?=ccu_h($ccu_claude['source'] ?? '')?></span><?endif;?><?if ($ccu_claude_err !== ''):?><span class="ccu-badge" data-tone="warn" title="<?=ccu_h($ccu_claude_err)?>">degraded</span><?endif;?></div>
</div>
<div class="ccu-card" data-tone="<?=ccu_h($ccu_mode_tone)?>">
<div class="ccu-card-label">_(Storage mode)_</div>
<div class="ccu-card-value"><?=ccu_h($ccu_mode)?></div>
<div class="ccu-card-sub"><?=ccu_h($ccu_mode === 'pool' ? 'login and transcripts persist on the pool' : ($ccu_mode === 'fallback' ? 'RAM only until the array starts' : 'helper did not answer'))?></div>
</div>
<div class="ccu-card" data-tone="<?=ccu_h($ccu_login ? 'ok' : 'neutral')?>">
<div class="ccu-card-label">_(Login)_</div>
<div class="ccu-card-value"><?=ccu_h($ccu_login ? 'yes' : 'no')?></div>
<div class="ccu-card-sub"><span>emergency token</span><?=ccu_yesno_badge($ccu_auth['emergency_token'] ?? false)?></div>
</div>
<div class="ccu-card" data-tone="<?=ccu_h($ccu_tmux_ok ? ($ccu_running > 0 ? 'info' : 'neutral') : 'warn')?>">
<div class="ccu-card-label">_(Sessions)_</div>
<div class="ccu-card-value"><?=(int) $ccu_running?></div>
<div class="ccu-card-sub"><?if ($ccu_tmux_ok):?><span>supervised, tmux <?=ccu_h($ccu_tmux['version'] ?? '')?></span><?else:?><?=ccu_badge('tmux missing', 'warn')?><?endif;?></div>
</div>
<div class="ccu-card" data-tone="<?=ccu_h($ccu_dd_ok ? 'ok' : 'bad')?>">
<div class="ccu-card-label">_(Data)_</div>
<div class="ccu-card-value"><?=ccu_h($ccu_dd_ok ? (is_int($ccu_dd_bytes) ? ccu_bytes($ccu_dd_bytes) : 'unknown') : 'not usable')?></div>
<div class="ccu-card-sub"><?if ($ccu_dd_ok && is_int($ccu_dd_tr)):?><span>transcripts <?=ccu_h(ccu_bytes($ccu_dd_tr))?></span><?elseif (!$ccu_dd_ok):?><span><?=ccu_h($ccu_dd['reason'] ?? '')?></span><?endif;?></div>
</div>
<div class="ccu-card" data-tone="neutral">
<div class="ccu-card-label">_(Plugin)_</div>
<div class="ccu-card-value"><?=ccu_h($ccu_status['plugin_version'] ?? 'unknown')?></div>
<div class="ccu-card-sub"><span><?=(int) count($ccu_policy)?> policy file<?=count($ccu_policy) === 1 ? '' : 's'?></span><?if (($ccu_status['claude_md'] ?? false) === true):?><?=ccu_badge('CLAUDE.md', 'info')?><?endif;?></div>
</div>
</div>

