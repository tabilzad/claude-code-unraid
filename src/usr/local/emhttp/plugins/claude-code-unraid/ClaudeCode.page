<div class="ccu-section-copy">
<h3 class="ccu-section-title"><?=ccu_icon('folder')?>_(Where things are)_</h3>
<p class="ccu-section-desc">The same facts as <code>claude-unraid status</code> in a terminal.</p>
</div>
</div>
<div class="ccu-kv">
<div class="ccu-k">_(Data directory)_</div>
<div class="ccu-v"><span class="ccu-path"><?=ccu_h($ccu_dd['path'] ?? '')?></span><?if (!$ccu_dd_ok):?><?=ccu_badge('not usable', 'bad')?><span><?=ccu_h($ccu_dd['reason'] ?? '')?></span><?elseif (($ccu_dd['fuse'] ?? false) === true):?><?=ccu_badge('/mnt/user, FUSE', 'warn')?><?endif;?></div>
<div class="ccu-k">_(Config directory)_</div>
<div class="ccu-v"><span class="ccu-path"><?=ccu_h($ccu_status['config_dir'] ?? '')?></span></div>
<div class="ccu-k">_(Policy files)_</div>
<div class="ccu-v"><?if ($ccu_policy):?><?foreach ($ccu_policy as $ccu_pf):?><span class="ccu-path"><?=ccu_h((string) $ccu_pf)?></span><?endforeach;?><?else:?><span>none</span><?endif;?><?if (($ccu_status['claude_md'] ?? false) === true):?><span class="ccu-path">CLAUDE.md</span><span>(Unraid context)</span><?endif;?></div>
<div class="ccu-k">_(tmux)_</div>
<div class="ccu-v"><?if ($ccu_tmux_ok):?><span><?=ccu_h($ccu_tmux['version'] ?? '')?></span><?else:?><?=ccu_badge('not available', 'warn')?><span>supervised sessions disabled<?if (($ccu_tmux['error'] ?? '') !== ''):?>: <?=ccu_h($ccu_tmux['error'])?><?endif;?></span><?endif;?></div>
<div class="ccu-k">_(Emergency token)_</div>
<div class="ccu-v"><?=ccu_yesno_badge($ccu_auth['emergency_token'] ?? false)?><span>managed with <code class="ccu-cmd">claude-unraid token</code></span></div>
