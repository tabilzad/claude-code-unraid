</div>
<?if ($ccu_workspaces):?>
<table class="ccu-table">
<thead><tr><th>_(Workspace)_</th><th>_(Path)_</th><th>_(Last used)_</th><th>_(Session)_</th><th></th></tr></thead>
<tbody>
<?foreach ($ccu_workspaces as $ccu_w):?>
<?[$ccu_wname, $ccu_wpath, $ccu_wmtime, $ccu_wstate] = array_pad(explode('|', (string) $ccu_w, 4), 4, '');?>
<tr><td><?=ccu_h($ccu_wname)?></td><td><span class="ccu-path"><?=ccu_h($ccu_wpath)?></span></td><td><?=ccu_h(ctype_digit($ccu_wmtime) && (int) $ccu_wmtime > 0 ? date('Y-m-d H:i', (int) $ccu_wmtime) : '')?></td><td><?if ($ccu_wstate !== '' && $ccu_wstate !== '-'):?><?=ccu_badge($ccu_wstate, $ccu_wstate === 'running' ? 'ok' : 'neutral')?><?endif;?></td><td class="ccu-td-actions"><button type="button" class="ccu-btn ccu-btn-sm" onclick="openTerminal('ttyd', <?=ccu_h(json_encode($ccu_wname, JSON_UNESCAPED_SLASHES))?>, <?=ccu_h(json_encode($ccu_wpath, JSON_UNESCAPED_SLASHES))?>)"><?=ccu_icon('terminal')?><span>_(Open terminal)_</span></button></td></tr>
