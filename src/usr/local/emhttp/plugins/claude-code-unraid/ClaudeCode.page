<?foreach ($ccu_sessions as $ccu_s):?>
<?[$ccu_ws, $ccu_state, $ccu_sid, $ccu_started] = array_pad(explode('|', (string) $ccu_s, 4), 4, '');?>
<tr><td><?=ccu_h($ccu_ws)?></td><td><?=ccu_badge($ccu_state, $ccu_state === 'running' ? 'ok' : 'neutral')?></td><td><span class="ccu-path"><?=ccu_h(substr($ccu_sid, 0, 12))?></span></td><td><?=ccu_h($ccu_started)?></td><td><code class="ccu-cmd">claude-unraid attach <?=ccu_h($ccu_ws)?></code></td></tr>
