<?xml version="1.0" standalone="yes"?>
<!-- SPDX-License-Identifier: MIT -->
<!--
  Claude Code for Unraid: plugin definition template.

  scripts/render-plg replaces every at-sign marker from the build (version,
  package name and sha256), release/claude-code.lock and release/tmux.lock, then
  scripts/lint-plg checks the result. Never edit a rendered .plg by hand.

  Design rules (CLAUDE.md invariants 1, 3, 4, 9):
  - the only <URL> element is our own small package, cached on the flash drive
    with a <SHA256>, so a boot with a valid cache never downloads anything;
  - the large Claude Code binary and the tmux package are fetched by scripts
    from the package that verify them and degrade gracefully, never by the
    plugin manager (a failed <URL> at boot would disable the whole plugin);
  - every inline step except the package install itself exits 0;
  - nothing here touches /mnt.
-->
<!DOCTYPE PLUGIN [
<!ENTITY name          "claude-code-unraid">
<!ENTITY author        "tabilzad">
<!ENTITY version       "2026.01.02.3">
<!ENTITY pluginVersion "0.1.0-beta.1">
<!ENTITY gitURL        "https://github.com/tabilzad/claude-code-unraid">
<!ENTITY pluginURL     "&gitURL;/releases/latest/download/&name;.plg">
<!ENTITY support       "https://forums.unraid.net/topic/201128-plugin-claude-code-for-unraid-claude-code-cli-on-the-host-with-sessions-that-survive-reboots-beta/">
<!ENTITY launch        "Settings/ClaudeCode">
<!ENTITY icon          "terminal">
<!ENTITY minVer        "7.0.0">
<!ENTITY txzName       "claude-code-unraid-2026.01.02.3-noarch-1.txz">
<!ENTITY txzURL        "https://github.com/tabilzad/claude-code-unraid/releases/download/v0.1.0-beta.1/claude-code-unraid-2026.01.02.3-noarch-1.txz">
<!ENTITY txzSHA256     "1111111111111111111111111111111111111111111111111111111111111111">
<!ENTITY claudeVersion "2.1.308">
<!ENTITY claudeSHA256  "356733f185fa988e6bf3aa9a555269fdd167982a2e2a80d3c8a78037bb92ad58">
<!ENTITY claudeURL     "https://downloads.claude.ai/claude-code-releases/2.1.308/linux-x64/claude">
<!ENTITY claudeSize    "292232560">
<!ENTITY tmuxPkg       "tmux-3.2a-x86_64-1.txz">
<!ENTITY tmuxURL       "https://mirrors.slackware.com/slackware/slackware64-15.0/slackware64/ap/tmux-3.2a-x86_64-1.txz">
<!ENTITY tmuxSHA256    "c54aaafd013b09ade3ffbdc553b64b9a29835bc717435982defced205a6772b9">
<!ENTITY tmuxSize      "366896">
<!ENTITY flashDir      "/boot/config/plugins/&name;">
<!ENTITY emhttpDir     "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        pluginURL="&pluginURL;"
        min="&minVer;"
        support="&support;"
        launch="&launch;"
        icon="&icon;">

<CHANGES>
##&name;
###&version; (&pluginVersion;)
Claude Code &claudeVersion; (linux-x64, sha256 pinned from Anthropic's signed manifest).

### Unreleased

#### Added

- Something not released yet with an ampersand: A &amp; B.

### [0.1.0-beta.1] - 2026-01-02

#### Added

- First beta.
- A `&lt;code&gt;` sample.

### [0.0.2] - 2025-12-31

#### Fixed

- Second oldest entry.
</CHANGES>

<!-- 1. Directories the later steps rely on. Nothing else happens here. -->
<FILE Run="/bin/bash" Method="install">
<INLINE>
mkdir -p "&flashDir;/pkg" "&flashDir;/policy.d" "&emhttpDir;"
exit 0
</INLINE>
</FILE>

<!-- 2. The plugin package: the only downloaded element. The plugin manager keeps
     the cached copy while its SHA256 matches, so boots never hit the network. -->
<FILE Name="&flashDir;/pkg/&txzName;">
<URL>"&txzURL;"</URL>
<SHA256>&txzSHA256;</SHA256>
</FILE>

<!-- 3. Install the package and drop older cached packages. This is the one
     step allowed to fail the install: without the package nothing else works. -->
<FILE Run="/bin/bash" Method="install">
<INLINE>
pkg="&flashDir;/pkg/&txzName;"
if ! upgradepkg --install-new --reinstall "$pkg"; then
  echo "&name;: upgradepkg failed for $pkg" >&amp;2
  exit 1
fi
find "&flashDir;/pkg" -maxdepth 1 -type f -name '&name;-*.txz' ! -name '&txzName;' -delete 2>/dev/null
exit 0
</INLINE>
</FILE>

<!-- 4. Claude Code binary and tmux: fetched, verified and cached by scripts from
     the package. Both degrade gracefully and report through status/doctor. -->
<FILE Run="/bin/bash" Method="install">
<INLINE>
run_step() {
  local script="&emhttpDir;/scripts/$1"
  if [ -x "$script" ]; then
    "$script" || echo "&name;: $1 exited with status $? (continuing)" >&amp;2
  else
    echo "&name;: $script is missing; was the package installed?" >&amp;2
  fi
}
export CLAUDE_VERSION="&claudeVersion;" CLAUDE_SHA256="&claudeSHA256;" CLAUDE_URL="&claudeURL;" CLAUDE_SIZE="&claudeSize;"
run_step install-binary
export TMUX_PKG="&tmuxPkg;" TMUX_URL="&tmuxURL;" TMUX_SHA256="&tmuxSHA256;" TMUX_SIZE="&tmuxSize;"
run_step install-tmux
exit 0
</INLINE>
</FILE>

<!-- 5. Managed policy baseline, runtime state and the install summary. -->
<FILE Run="/bin/bash" Method="install">
<INLINE>
run_step() {
  local script="&emhttpDir;/scripts/$1"
  if [ -x "$script" ]; then
    "$script" || echo "&name;: $1 exited with status $? (continuing)" >&amp;2
  else
    echo "&name;: $script is missing; was the package installed?" >&amp;2
  fi
}
run_step install-policy
run_step post-install
exit 0
</INLINE>
</FILE>

<!-- Remove: the package's own script does the work (SPEC section 5). The
     fallback only runs when the package is not installed (partial install). -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
if [ -x "&emhttpDir;/scripts/remove" ]; then
  "&emhttpDir;/scripts/remove" || echo "&name;: remove exited with status $?" >&amp;2
else
  echo "&name;: package scripts missing, cleaning up what a partial install leaves behind"
  removepkg &name; >/dev/null 2>&amp;1
  rm -rf "/usr/local/lib/&name;" "/run/&name;" "&emhttpDir;" "/etc/claude-code/managed-settings.d/99-&name;-baseline.json"
  rm -f /usr/local/bin/claude /usr/local/bin/claude-unraid
  rm -rf "&flashDir;/bin" "&flashDir;/pkg"
  echo "&name;: kept &flashDir;/&name;.cfg, &flashDir;/policy.d and your data directory"
fi
exit 0
</INLINE>
</FILE>
</PLUGIN>
