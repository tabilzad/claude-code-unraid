#!/usr/bin/env bash
# render-plg: fill plugin/claude-code-unraid.plg.in from the build and the locks.
#
#   render-plg --version V --plugin-version SEMVER \
#              (--txz PATH | --txz-name NAME --txz-sha256 HEX) \
#              [--txz-url URL] [--lock FILE] [--tmux-lock FILE] \
#              [--changelog FILE] [--template FILE] --out FILE
#
# Every value is validated before it is substituted, placeholders that survive
# the substitution are an error, and the result is written atomically. The
# lock files are parsed with sed, never sourced.
set -euo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PLUGIN=claude-code-unraid
GIT_URL=https://github.com/tabilzad/claude-code-unraid
readonly REPO_ROOT PLUGIN GIT_URL

die() {
  printf 'render-plg: %s\n' "$*" >&2
  exit 1
}

version=""
plugin_version=""
txz=""
txz_name=""
txz_sha256=""
txz_url=""
lock="$REPO_ROOT/release/claude-code.lock"
tmux_lock="$REPO_ROOT/release/tmux.lock"
changelog="$REPO_ROOT/CHANGELOG.md"
template="$REPO_ROOT/plugin/$PLUGIN.plg.in"
out=""
while [ $# -gt 0 ]; do
  case "$1" in
    --version)
      version=${2:-}
      shift 2
      ;;
    --plugin-version)
      plugin_version=${2:-}
      shift 2
      ;;
    --txz)
      txz=${2:-}
      shift 2
      ;;
    --txz-name)
      txz_name=${2:-}
      shift 2
      ;;
    --txz-sha256)
      txz_sha256=${2:-}
      shift 2
      ;;
    --txz-url)
      txz_url=${2:-}
      shift 2
      ;;
    --lock)
      lock=${2:-}
      shift 2
      ;;
    --tmux-lock)
      tmux_lock=${2:-}
      shift 2
      ;;
    --changelog)
      changelog=${2:-}
      shift 2
      ;;
    --template)
      template=${2:-}
      shift 2
      ;;
    --out)
      out=${2:-}
      shift 2
      ;;
    *) die "unknown argument '$1'" ;;
  esac
done

version_re='^[0-9]{4}\.[0-9]{2}\.[0-9]{2}\.[0-9](-dev)?$'
semver_re='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$'
txz_name_re="^$PLUGIN-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9](_dev)?-noarch-[0-9]+\\.txz\$"
sha256_re='^[a-f0-9]{64}$'
# Characters that are safe both inside an XML attribute/text and in the shell
# snippets the plg runs: no quotes, no "&", no whitespace, no "<" or ">".
url_re="^https?://[A-Za-z0-9._~:/?#@!\$()*+,;=%-]+\$"

[[ "$version" =~ $version_re ]] || die "--version must be YYYY.MM.DD.N or 0000.00.00.0-dev"
[[ "$plugin_version" =~ $semver_re ]] || die "--plugin-version must be a semantic version"
[ -n "$out" ] || die "--out is required"
[ -r "$template" ] || die "template not readable: $template"
[ -r "$changelog" ] || die "changelog not readable: $changelog"

if [ -n "$txz" ]; then
  [ -r "$txz" ] || die "package not readable: $txz"
  txz_name=$(basename -- "$txz")
  txz_sha256=$(sha256sum -- "$txz" | cut -d' ' -f1)
fi
[[ "$txz_name" =~ $txz_name_re ]] || die "package name is not NAME-VERSION-noarch-BUILD.txz: '$txz_name'"
[ "${txz_name#"$PLUGIN-"}" = "${version//-/_}-noarch-${txz_name##*-noarch-}" ] || die "package name '$txz_name' does not carry version '$version'"
[[ "$txz_sha256" =~ $sha256_re ]] || die "package sha256 is malformed"
[ -n "$txz_url" ] || txz_url="$GIT_URL/releases/download/v$plugin_version/$txz_name"
[[ "$txz_url" =~ $url_re ]] || die "package URL contains characters that are unsafe in XML or shell: '$txz_url'"

# lock_get FILE KEY REGEX
lock_get() {
  local file=$1 key=$2 regex=$3 value
  [ -r "$file" ] || die "lock file not readable: $file"
  value=$(sed -n "s/^${key}=//p" -- "$file" | head -n1)
  [ -n "$value" ] || die "$key missing from $file"
  [[ "$value" =~ $regex ]] || die "$key in $file has an unexpected value: '$value'"
  printf '%s' "$value"
}

claude_version=$(lock_get "$lock" CLAUDE_VERSION '^[0-9]+\.[0-9]+\.[0-9]+$')
claude_sha256=$(lock_get "$lock" CLAUDE_SHA256 "$sha256_re")
claude_url=$(lock_get "$lock" CLAUDE_URL '^https://downloads\.claude\.ai/claude-code-releases/[0-9.]+/linux-x64/claude$')
claude_size=$(lock_get "$lock" CLAUDE_SIZE '^[0-9]+$')
[ "$claude_url" = "https://downloads.claude.ai/claude-code-releases/$claude_version/linux-x64/claude" ] || die "CLAUDE_URL does not match CLAUDE_VERSION"

tmux_pkg=$(lock_get "$tmux_lock" TMUX_PKG '^tmux-[0-9A-Za-z._]+-x86_64-[0-9]+\.txz$')
tmux_url=$(lock_get "$tmux_lock" TMUX_URL '^https://mirrors\.slackware\.com/slackware/slackware64-15\.0/slackware64/ap/tmux-[0-9A-Za-z._]+-x86_64-[0-9]+\.txz$')
tmux_sha256=$(lock_get "$tmux_lock" TMUX_SHA256 "$sha256_re")
tmux_size=$(lock_get "$tmux_lock" TMUX_SIZE '^[0-9]+$')
[ "${tmux_url##*/}" = "$tmux_pkg" ] || die "TMUX_URL does not end with TMUX_PKG"

# CHANGES: the latest three changelog sections, demoted one heading level so
# they nest under the plugin manager's own headings, then XML-escaped.
changes=$("$REPO_ROOT/scripts/changelog-extract" --file "$changelog" --latest 3 |
  sed -e 's/^### /#### /' -e 's/^## /### /' -e 's/^### \[Unreleased\]/### Unreleased/' |
  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')
[ -n "$(printf '%s' "$changes" | tr -d '[:space:]')" ] || die "changelog has no sections"

content=$(cat -- "$template")
substitute() {
  local key=$1 value=$2
  case "$value" in
    *@*) die "value for $key contains '@', which the template syntax reserves" ;;
  esac
  content=${content//"@$key@"/"$value"}
}
substitute VERSION "$version"
substitute PLUGIN_VERSION "$plugin_version"
substitute TXZ_NAME "$txz_name"
substitute TXZ_URL "$txz_url"
substitute TXZ_SHA256 "$txz_sha256"
substitute CLAUDE_VERSION "$claude_version"
substitute CLAUDE_SHA256 "$claude_sha256"
substitute CLAUDE_URL "$claude_url"
substitute CLAUDE_SIZE "$claude_size"
substitute TMUX_PKG "$tmux_pkg"
substitute TMUX_URL "$tmux_url"
substitute TMUX_SHA256 "$tmux_sha256"
substitute TMUX_SIZE "$tmux_size"
# CHANGES may legitimately contain '@' (e-mail addresses), so it goes last and
# bypasses the reserved-character check.
content=${content//"@CHANGES@"/"$changes"}

if leftover=$(printf '%s\n' "$content" | grep -o '@[A-Z_][A-Z_]*@' | sort -u) && [ -n "$leftover" ]; then
  die "unreplaced placeholders: $(printf '%s' "$leftover" | tr '\n' ' ')"
fi

mkdir -p -- "$(dirname -- "$out")"
tmp=$(mktemp -- "$(dirname -- "$out")/.render-plg.XXXXXXXX")
printf '%s\n' "$content" >"$tmp"
mv -f -- "$tmp" "$out"
printf '%s\n' "$out"
