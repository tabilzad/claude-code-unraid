#!/usr/bin/env php
<?php
/*
 * lint-escaping: no .page or PHP file may print a variable into HTML without
 * escaping it.
 *
 *   lint-escaping [--allow FILE] PATH...
 *
 * Flags every `<?= ... ?>`, `echo ...` and `print ...` whose expression
 * contains a `$variable` and is not wrapped in htmlspecialchars(), ccu_h(),
 * json_encode(), ccu_yesno(), ccu_select(), ccu_badge(), ccu_yesno_badge()
 * (the last three escape internally, see include/ui.php), or an `(int)` cast,
 * and is not a plain string literal. Justified exceptions go in
 * the allow file, one per line: `relative/path:regex`. Exit 1 on findings.
 */
declare(strict_types=1);

$allowFile = null;
$paths = [];
$args = array_slice($argv, 1);
while ($args !== []) {
    $a = array_shift($args);
    if ($a === '--allow') {
        $allowFile = array_shift($args) ?? '';
        continue;
    }
    $paths[] = $a;
}
if ($paths === []) {
    fwrite(STDERR, "usage: lint-escaping [--allow FILE] PATH...\n");
    exit(2);
}

$allow = [];
if ($allowFile !== null && is_readable($allowFile)) {
    foreach (file($allowFile, FILE_IGNORE_NEW_LINES) ?: [] as $line) {
        $line = trim($line);
        if ($line === '' || $line[0] === '#') {
            continue;
        }
        [$f, $re] = array_pad(explode(':', $line, 2), 2, '');
        $allow[] = [$f, $re];
    }
}

function files(array $paths): array
{
    $out = [];
    foreach ($paths as $p) {
        if (is_file($p)) {
            $out[] = $p;
            continue;
        }
        $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($p, FilesystemIterator::SKIP_DOTS));
        foreach ($it as $f) {
            if (preg_match('/\.(page|php)$/', $f->getFilename())) {
                $out[] = $f->getPathname();
            }
        }
    }
    sort($out);
    return $out;
}

$safe = '/^\s*(htmlspecialchars|ccu_h|json_encode|ccu_yesno|ccu_select|ccu_badge|ccu_yesno_badge|\(int\)|intval|count)\s*\(?/';
$findings = 0;
foreach (files($paths) as $file) {
    $src = file_get_contents($file) ?: '';
    $rel = ltrim(str_replace(getcwd(), '', $file), '/');
    $exprs = [];
    if (preg_match_all('/<\?=\s*(.*?)\s*\?>/s', $src, $m, PREG_OFFSET_CAPTURE)) {
        foreach ($m[1] as $hit) {
            $exprs[] = $hit;
        }
    }
    if (preg_match_all('/\b(?:echo|print)\s+(.*?);/s', $src, $m, PREG_OFFSET_CAPTURE)) {
        foreach ($m[1] as $hit) {
            $exprs[] = $hit;
        }
    }
    foreach ($exprs as [$expr, $offset]) {
        if (!str_contains($expr, '$')) {
            continue; // string literal or constant
        }
        if (preg_match($safe, $expr)) {
            continue;
        }
        $line = substr_count(substr($src, 0, $offset), "\n") + 1;
        $allowed = false;
        foreach ($allow as [$f, $re]) {
            // the path part is a suffix, a prefix (a directory) or any segment
            if (str_contains('/' . $rel, $f) && @preg_match('/' . $re . '/', $expr) === 1) {
                $allowed = true;
            }
        }
        if ($allowed) {
            continue;
        }
        fwrite(STDERR, "lint-escaping: $rel:$line: unescaped output: " . trim(preg_replace('/\s+/', ' ', $expr) ?? $expr) . "\n");
        $findings++;
    }
}
if ($findings > 0) {
    fwrite(STDERR, "lint-escaping: $findings finding(s)\n");
    exit(1);
}
echo "lint-escaping: ok\n";
